# Set these in the environment that launches the backend. Never commit real credentials.
ALERT_SMTP_HOST=smtp.example.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=alerts@example.com
ALERT_SMTP_PASSWORD=replace-with-an-app-password
ALERT_SMTP_SSL=false
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=operations@example.com
